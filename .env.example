# Copy this file to .env and fill in your own key. Never commit the real .env file.

# Provider: groq | gemini  (if unset, Groq is used when GROQ_API_KEY is set)
LLM_PROVIDER=groq

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Gemini — https://aistudio.google.com/apikey  (optional alternative)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
